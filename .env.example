WIFI_SSID=your-network-name
WIFI_PASSWORD=your-network-password
# Optional additional networks. The Pico tries each network in order.
WIFI_SSID_2=another-network-name
WIFI_PASSWORD_2=another-network-password
# WIFI_SSID_3=...
# WIFI_PASSWORD_3=...
# WIFI_SSID_4=...
# WIFI_PASSWORD_4=...

# Optional fallback access point. If none of the networks above can be joined,
# the Pico opens this Wi-Fi and serves the web UI at http://192.168.4.1/.
# The password needs 8 to 63 characters. These are the defaults.
# AP_SSID=epaper-setup
# AP_PASSWORD=epaper1234
